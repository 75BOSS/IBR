# .env.example — Web IBR
# Copiar a .env.local para desarrollo. En Hostinger: hPanel → Web app → Variables de entorno
# (cargar TODAS antes del primer deploy). Nunca subir valores reales al repo.

# --- Sitio ------------------------------------------------------------------
# URL pública sin barra final. Se usa en metadata/OG, sitemap y enlaces de correos.
NEXT_PUBLIC_SITE_URL=https://dev.ibriglesia.com

# --- Base de datos (hPanel → Bases de datos MySQL → host remoto) ------------
# Formato: mysql://USUARIO:CLAVE@HOST:3306/NOMBRE_BD  (codificar caracteres especiales de la clave con %XX)
DATABASE_URL=mysql://USUARIO:CLAVE@HOST:3306/NOMBRE_BD

# BD del sistema PHP heredado, SOLO LECTURA. Solo la usa scripts/importar-php.ts (MIGRACION-PHP.md §2).
LEGACY_DATABASE_URL=mysql://USUARIO_LECTURA:CLAVE@HOST:3306/NOMBRE_BD_PHP

# Cuántos proxies de confianza agregan su IP a X-Forwarded-For delante de la app (Hostinger: 1).
# Confirmar con /admin/diagnostico; con un valor incorrecto, los límites de envío usan otra IP.
TRUSTED_PROXY_HOPS=1

# --- Sesión del admin (iron-session) ----------------------------------------
# Mínimo 32 caracteres aleatorios. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Cloudinary (imágenes de eventos, equipo, home) --------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Correo (SMTP de Hostinger) -----------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Iglesia Bíblica Riobamba <no-responder@ibriglesia.com>"

# --- YouTube Data API (opcional en F1; sin key el título de la prédica se escribe a mano) ---
YOUTUBE_API_KEY=
